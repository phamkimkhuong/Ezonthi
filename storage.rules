rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isBootstrapTeacher() {
      return signedIn()
        && request.auth.uid in [
          'hzSKwkaroTR1LKcXp09E5wL7F6f1'
        ];
    }

    function isTeacher() {
      return isBootstrapTeacher()
        || (
          signedIn()
          && firestore.exists(/databases/(default)/documents/teachers/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/teachers/$(request.auth.uid)).data.active == true
          && firestore.get(/databases/(default)/documents/teachers/$(request.auth.uid)).data.role == 'teacher'
        );
    }

    match /users/{userId}/attempts/{attemptId}/{fileName} {
      allow read: if isOwner(userId) || isTeacher();

      allow write: if isOwner(userId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    match /users/{userId}/chats/{questionId}/{fileName} {
      allow read: if isOwner(userId) || isTeacher();

      allow write: if isOwner(userId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    match /users/{userId}/general_chats/{subjectId}/{fileName} {
      allow read: if isOwner(userId) || isTeacher();

      allow write: if isOwner(userId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    match /users/{userId}/tickets/{ticketId}/{fileName} {
      allow read: if isOwner(userId) || isTeacher();

      allow write: if (userId == 'guests' || isOwner(userId))
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    match /chat_images/{studentId}/{fileName} {
      allow read, delete: if isOwner(studentId) || isTeacher();

      allow create, update: if (isOwner(studentId) || isTeacher())
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }
  }
}
