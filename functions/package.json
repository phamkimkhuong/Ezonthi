{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "packageManager": "npm@10.9.4",
  "scripts": {
    "build": "node ../scripts/build/buildServerLearningCatalog.mjs && tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions --project on-thi-vao-10-7d87c",
    "seed:knowledge": "node seedKnowledge.js",
    "migrate:knowledge-v2": "node migrateKnowledge.js",
    "verify:knowledge": "node verifyKnowledge.js",
    "seed:grammar": "node seedGrammarKnowledge.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "type": "module",
  "dependencies": {
    "@payos/node": "^2.0.5",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.4.5"
  },
  "private": true
}
