{
  "expo": {
    "name": "EZ Ôn Thi",
    "slug": "ezonthi-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ezonthi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ezonthi.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.ezonthi.app",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0f172a"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6366f1",
          "sounds": [
            "./assets/sounds/ting.wav"
          ]
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "no-dsg",
          "project": "ezonthi-mobile"
        }
      ],
      "expo-web-browser",
      "expo-sharing"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f5206c86-b87c-468e-b38c-ecdf3e8adda7"
      }
    },
    "owner": "phamkhuong436",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f5206c86-b87c-468e-b38c-ecdf3e8adda7"
    }
  }
}
