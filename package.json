{
  "name": "on-thi-vao-10",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": "22.x",
    "npm": ">=10.9 <11"
  },
  "scripts": {
    "dev": "vite",
    "check": "node scripts/tests/checkRepoHygiene.mjs && tsc -b --noEmit && eslint .",
    "type-check": "tsc -b --noEmit",
    "lint": "eslint .",
    "validate:content": "node scripts/validators/runAllValidators.mjs",
    "validate:grade10": "node scripts/validators/runAllValidators.mjs --grade=10",
    "validate:grade11": "node scripts/validators/runAllValidators.mjs --grade=11",
    "test": "npm run test:routes && npm run test:learning",
    "test:routes": "node scripts/tests/testCourseRoutes.mjs",
    "test:learning": "node scripts/tests/testLearningSync.mjs && npm run audit:numeric",
    "build": "node scripts/build/generateSitemap.mjs && tsc -b && vite build && node scripts/build/generateSeoPages.mjs",
    "validate:release": "npm run check && npm run test && npm run validate:content && npm run build",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy --only hosting --project on-thi-vao-10-7d87c",
    "deploy-rules": "firebase deploy --only firestore:rules,storage --project on-thi-vao-10-7d87c",
    "build:sitemap": "node scripts/build/generateSitemap.mjs",
    "audit:seo": "node scripts/build/auditSeoBuild.mjs",
    "audit:numeric": "node scripts/validators/rules/auditNumericValidators.mjs",
    "perf:audit": "node scripts/tests/runPerformanceAudit.mjs",
    "generate:math-choices": "node scripts/tools/generateMath10PracticeChoices.mjs && node scripts/tools/generateMath11PracticeChoices.mjs",
    "audit:math-practice": "node scripts/tools/auditMath10PracticeChoices.mjs && node scripts/tools/auditMath11PracticeChoices.mjs",
    "fix:latex": "node scripts/tools/fixLatex.mjs",
    "audit:diversity": "node scripts/tools/auditQuestionDiversity.mjs",
    "seed:knowledge": "npm --prefix functions run seed:knowledge",
    "seed:grammar": "npm --prefix functions run seed:grammar"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@sentry/react": "^10.69.0",
    "@tailwindcss/vite": "^4.3.2",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.15.0",
    "katex": "^0.18.0",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "react-is": "^19.2.8",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "firebase-tools": "^15.25.1",
    "globals": "^17.11.0",
    "lighthouse": "^12.8.2",
    "postcss": "^8.5.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.0"
  }
}